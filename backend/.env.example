# 参考配置，Spring Boot 不自动加载此文件；请通过终端或 IDE 设置环境变量。
# 启用 mysql profile 前须准备数据库和账号；当前不会生成业务表。
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://127.0.0.1:3306/personal_economy?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=personal_economy
DB_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
